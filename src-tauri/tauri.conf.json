{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartLinter",
  "version": "0.1.0",
  "identifier": "com.smartlinter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "https://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SmartLinter Dashboard",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
